# Generated by Terraform (terraform/templates/docker-compose.yml.tftpl).
# Each site gets its own WordPress + MariaDB pair on an isolated network.
# Only the WordPress containers join the "edge" network that cloudflared uses.
name: wordpress

services:
  cloudflared:
    image: ${cloudflared_image}
    restart: unless-stopped
    command: ["tunnel", "--no-autoupdate", "run"]
    env_file: [./secrets/cloudflared.env]
    networks: [edge]
    mem_limit: 256m
    read_only: true
    security_opt: ["no-new-privileges:true"]
%{ for key in site_keys ~}

  ${key}-db:
    image: ${mariadb_image}
    restart: unless-stopped
    environment:
      MARIADB_DATABASE: wordpress
      MARIADB_USER: wordpress
      MARIADB_PASSWORD_FILE: /run/secrets/${key}_db_password
      MARIADB_RANDOM_ROOT_PASSWORD: "1"
      MARIADB_AUTO_UPGRADE: "1"
    secrets: [${key}_db_password]
    volumes: ["${key}-db:/var/lib/mysql"]
    networks: [${key}]
    mem_limit: 512m
    security_opt: ["no-new-privileges:true"]
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 60s

  ${key}-wp:
    image: ${wordpress_image}
    restart: unless-stopped
    depends_on:
      ${key}-db:
        condition: service_healthy
    environment:
      WORDPRESS_DB_HOST: ${key}-db
      WORDPRESS_DB_NAME: wordpress
      WORDPRESS_DB_USER: wordpress
      WORDPRESS_DB_PASSWORD_FILE: /run/secrets/${key}_db_password
      WORDPRESS_CONFIG_EXTRA: "require '/usr/local/etc/wp-config-extra.php';"
    secrets: [${key}_db_password]
    volumes:
      - "${key}-wp:/var/www/html"
      - "./config/wp-config-extra.php:/usr/local/etc/wp-config-extra.php:ro"
      - "./config/php-overrides.ini:/usr/local/etc/php/conf.d/zz-overrides.ini:ro"
      - "./config/mpm_prefork.conf:/etc/apache2/mods-available/mpm_prefork.conf:ro"
    networks: [${key}, edge]
    mem_limit: 768m
    security_opt: ["no-new-privileges:true"]
%{ endfor ~}

networks:
  edge: {}
%{ for key in site_keys ~}
  ${key}:
    internal: true
%{ endfor ~}

volumes:
%{ for key in site_keys ~}
  ${key}-db: {}
  ${key}-wp: {}
%{ endfor ~}

secrets:
%{ for key in site_keys ~}
  ${key}_db_password:
    file: ./secrets/${key}_db_password
%{ endfor ~}
