#!/usr/bin/env bash
# Runs before every stack start (ExecStartPre of wordpress-stack.service):
#  - creates per-site DB passwords on first boot (they never leave the VM)
#  - refreshes the Cloudflare Tunnel token from Key Vault via managed identity
set -euo pipefail
umask 077

SECRETS_DIR=/opt/wordpress/secrets
install -d -m 0700 "$SECRETS_DIR"

for site in ${join(" ", site_keys)}; do
  f="$SECRETS_DIR/$${site}_db_password"
  if [[ ! -s "$f" ]]; then
    openssl rand -base64 48 | tr -d '\n/+=' > "$f"
  fi
  # Read inside the containers by non-root users; the parent dir stays 0700.
  chmod 0644 "$f"
done

IMDS_URL="http://169.254.169.254/metadata/identity/oauth2/token?api-version=2018-02-01&resource=https%3A%2F%2Fvault.azure.net"
KV_URL="https://${key_vault_name}.vault.azure.net/secrets/${secret_name}?api-version=7.4"
TOKEN_FILE="$SECRETS_DIR/cloudflared.env"

# First boot: wait for RBAC propagation. Later boots: fall back to the cached token quickly.
attempts=45
[[ -s "$TOKEN_FILE" ]] && attempts=3

for ((i = 1; i <= attempts; i++)); do
  if access_token=$(curl -fsS -H "Metadata: true" "$IMDS_URL" | jq -er .access_token) &&
    tunnel_token=$(curl -fsS -H "Authorization: Bearer $access_token" "$KV_URL" | jq -er .value); then
    printf 'TUNNEL_TOKEN=%s\n' "$tunnel_token" > "$TOKEN_FILE.tmp"
    mv -f "$TOKEN_FILE.tmp" "$TOKEN_FILE"
    echo "Tunnel token refreshed from Key Vault."
    exit 0
  fi
  echo "Key Vault not readable yet (attempt $i/$attempts); retrying in 20s." >&2
  sleep 20
done

if [[ -s "$TOKEN_FILE" ]]; then
  echo "Using cached tunnel token." >&2
  exit 0
fi

echo "ERROR: could not fetch the tunnel token from Key Vault." >&2
exit 1
